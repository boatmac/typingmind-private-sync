{
  "name": "typingmind-private-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:pages": "node scripts/build.mjs --pages",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "pretest": "npm run build",
    "test": "tsx --test test/*.test.ts",
    "test:live": "npm run build && tsx --test test/live/*.test.ts",
    "gateway": "node --env-file-if-exists=.env.gateway.local dist/koofr-gateway.mjs",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "aws4fetch": "1.0.20",
    "fast-xml-parser": "^5.12.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.0",
    "fake-indexeddb": "^6.2.4",
    "fflate": "^0.8.2",
    "playwright": "^1.56.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
